<?xml version="1.0" encoding="utf-8"?>
<!-- One photo in the picker: a 16:9 thumbnail, then its name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="6dp"
    android:padding="6dp"
    android:background="@drawable/wallpaper_tile_bg"
    android:focusable="true"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:background="@drawable/thumbnail_bg"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:id="@+id/wallpaperLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:singleLine="true"
        android:ellipsize="middle"
        android:textColor="#E6FFFFFF"
        android:textSize="14sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 400"
        android:includeFontPadding="false" />
</LinearLayout>

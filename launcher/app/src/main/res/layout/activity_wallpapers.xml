<?xml version="1.0" encoding="utf-8"?>
<!-- The album, over the same room as the home screen so a photo can be judged in place. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/wallpaperBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.35"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="60dp"
        android:paddingEnd="60dp"
        android:paddingTop="44dp"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wallpaper_title"
            android:textColor="#F2FFFFFF"
            android:textSize="30sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 300"
            android:letterSpacing="-0.01"
            android:includeFontPadding="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/wallpaper_subtitle"
            android:textColor="#8CFFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit"
            android:letterSpacing="0.18"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/shuffle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/wallpaper_shuffle_off"
            android:textSize="19sp"
            android:fontFamily="@font/outfit"
            android:textColor="@color/chip_text"
            android:background="@drawable/chip_bg"
            android:focusable="true"
            android:clickable="true"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp" />

        <TextView
            android:id="@+id/wallpaperEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:visibility="gone"
            android:text="@string/wallpaper_empty"
            android:textColor="#B3FFFFFF"
            android:textSize="17sp"
            android:lineSpacingExtra="4dp"
            android:fontFamily="@font/outfit" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/photos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:scrollbars="none" />
    </LinearLayout>
</FrameLayout>

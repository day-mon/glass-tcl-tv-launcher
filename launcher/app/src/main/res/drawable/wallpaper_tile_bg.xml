<?xml version="1.0" encoding="utf-8"?>
<!-- The thumbnail's own edges carry the state: focus adds a rim, the chosen photo keeps a quiet one. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#4DFFFFFF" />
            <stroke android:width="2dp" android:color="#E6FFFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#26FFFFFF" />
            <stroke android:width="2dp" android:color="#99FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>
